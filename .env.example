# ── Required ───────────────────────────────────────────────────────────────────
# Powers the trader and researcher agents.
OPENAI_API_KEY=

# ── Research MCP servers ───────────────────────────────────────────────────────
# Tavily web search, used by the Researcher agent (tool-filtered to tavily_search).
TAVILY_API_KEY=

# ── Optional: live market data ─────────────────────────────────────────────────
# Without this, backend/market_simulator.py serves deterministic simulated prices
# and the whole trading floor still runs end to end.
# Note: live last-trade prices require a paid Massive tier; the client in
# backend/market.py falls back through snapshot -> previous close automatically.
MASSIVE_API_KEY=

# ── Optional: push notifications ───────────────────────────────────────────────
# Traders send a summary push after each trading round. Leave blank to skip.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# ── Scheduler ──────────────────────────────────────────────────────────────────
# How often the trading floor wakes up and runs all four traders.
RUN_EVERY_N_MINUTES=60

# Set true to trade outside US market hours — useful for testing and for
# running the floor on simulated prices.
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# Set true to give each trader a different model (requires the extra keys below).
USE_MANY_MODELS=false

# Only needed when USE_MANY_MODELS=true
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=
